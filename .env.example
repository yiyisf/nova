# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# PostgreSQL
DATABASE_URL=postgres://nova:nova@127.0.0.1:5432/nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_DB=nova

# Redis (reserved for queues / pubsub; not required for a single-process Phase 1)
REDIS_URL=redis://127.0.0.1:6379

# 32-byte key as 64 hex chars, 32-byte base64, or a passphrase (scrypt-derived)
NOVA_MASTER_KEY=change-me-please-use-a-long-random-string
NOVA_SESSION_SECRET=change-me-session-secret-16+

# Data directories (bind-mounted in Docker)
DATA_DIR=/var/nova/data
WORKSPACE_DIR=/var/nova/workspaces
HARNESS_DIR=/var/nova/harness

# Sandbox: docker (isolated) or local (UNSAFE, host process)
SANDBOX_MODE=local
SANDBOX_IMAGE=nova-sandbox:local
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS=128
# Absolute host path of WORKSPACE_DIR when the API container talks to the host Docker daemon
SANDBOX_HOST_WORKSPACE_DIR=

# Optional web search: tavily | brave | searxng | none
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=

# Admin defaults (optional). Users still add their own encrypted keys in the UI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_ID=gpt-4o-mini
