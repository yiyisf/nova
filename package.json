{
  "name": "nova",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted multi-user personal AI assistant platform",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @nova/server dev & pnpm --filter @nova/web dev",
    "dev:server": "pnpm --filter @nova/server dev",
    "dev:web": "pnpm --filter @nova/web dev",
    "db:migrate": "pnpm --filter @nova/server migrate",
    "db:seed": "pnpm --filter @nova/server seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.8",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
