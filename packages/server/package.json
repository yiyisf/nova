{
  "name": "@nova/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@nova/runtime": "workspace:*",
    "@nova/sandbox": "workspace:*",
    "@nova/shared": "workspace:*",
    "argon2": "^0.43.1",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.9",
    "postgres": "^3.4.7",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "typescript": "^5.9.3"
  }
}
